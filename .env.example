# Convex deployment URL (from `npx convex dev` or Convex dashboard)
VITE_CONVEX_URL=

# Convex deploy key for CI / Render backend sync (optional for local dev)
CONVEX_DEPLOY_KEY=

# x.ai Voice + ship AI interpret + TTS fallback (server-side only; do NOT use VITE_ prefix)
XAI_API_KEY=

# Fal.ai image + audio: planet textures, ship avatar, TTS (server-side only)
FAL_KEY=

# Telegram Bot token (Mini App + Stars webhook)
TELEGRAM_BOT_TOKEN=

# Mock Stars payments in dev (1) or force off in dev (0). Production: set STARS_MOCK=1 to demo.
STARS_MOCK=

# Public app URL for Telegram WebApp menu button (Render web service URL)
VITE_APP_URL=

# Render sets PORT automatically for the web service (default 10000 locally)
PORT=10000
