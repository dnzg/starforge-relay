# Convex deployment URL (from `npx convex dev` or Convex dashboard)
VITE_CONVEX_URL=

# Convex deploy key for CI / Render backend sync (optional for local dev)
CONVEX_DEPLOY_KEY=

# x.ai Voice + ship AI interpret (server-side only; do NOT use VITE_ prefix)
XAI_API_KEY=

# Fal.ai texture generation for sector planets (server-side only)
FAL_KEY=

# Telegram Bot token (configure Mini App + webhook later)
TELEGRAM_BOT_TOKEN=

# Public app URL for Telegram WebApp menu button (Render web service URL)
VITE_APP_URL=

# Render sets PORT automatically for the web service (default 10000 locally)
PORT=10000
