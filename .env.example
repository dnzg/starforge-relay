# Convex deployment URL (from `npx convex dev` or Convex dashboard)
VITE_CONVEX_URL=

# Convex deploy key for CI / Render backend sync (optional for local dev)
CONVEX_DEPLOY_KEY=

# x.ai Voice API (future voice-first integration)
XAI_API_KEY=

# Fal.ai texture generation for sector planets (server-side; do NOT use VITE_ prefix)
FAL_KEY=

# Telegram Bot token (configure Mini App + webhook later)
TELEGRAM_BOT_TOKEN=

# Public app URL for Telegram WebApp menu button (Render static site URL)
VITE_APP_URL=
